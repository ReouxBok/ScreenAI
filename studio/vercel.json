{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/sav-v0": false,
      "codex/sav-bug-20-generation": false,
      "codex/sav-20-sdk-security": false,
      "codex/ugo": false,
      "codex/ugo/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/memory-retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/gmail-watch-renew",
      "schedule": "11 4 * * *"
    },
    {
      "path": "/api/cron/sav-reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}
